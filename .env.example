# ============================================================
# LabPulse AI — College Edition V7 Environment Configuration
# Copy this file to .env and configure for local deployment.
# NEVER commit real credentials or .env to version control.
# ============================================================

# Secret key for JWT session tokens (Change to a strong random key in production)
LABPULSE_SECRET_KEY=your-random-secret-key-for-labpulse-v7-development-here

# Optional SMTP configuration for HOD notification emails
# If left blank, notifications operate in logged simulation mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_college_notifications@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_TLS=true
